{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true
  },
  "include": [
    "src/App.tsx",
    "src/main.tsx",
    "src/core/**/*.ts",
    "src/core/**/*.tsx",
    "src/library/**/*.ts",
    "src/library/**/*.tsx",
    "src/experiments/**/*.ts",
    "src/experiments/**/*.tsx",
    "src/shared/**/*.ts",
    "src/shared/**/*.tsx"
  ]
}
