{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true
  },
  "include": [
    "src/App.tsx",
    "src/main.tsx",
    "src/experiments/ipho-2024-e2/**/*.ts",
    "src/experiments/ipho-2024-e2/**/*.tsx",
    "src/shared/**/*.tsx",
    "src/components/3d/controls/SimpleOrbitControls.ts"
  ]
}
